PORT=5000
# Set to "production" on the host so the server serves the built React app.
NODE_ENV=production

# Database (MySQL)
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASS=your-db-password
DB_NAME=daily_tasks_db
# Hosted MySQL needs TLS. Set true on the host (TiDB/Aiven/Railway/PlanetScale).
DB_SSL=false
# Aiven: paste the contents of ca.pem (Overview page) here. Literal 
 is accepted.
DB_SSL_CA=
# Set false only if the provider uses a self-signed CA and you skip DB_SSL_CA.
DB_SSL_REJECT_UNAUTHORIZED=true

# Auth — change this to a long random string
JWT_SECRET=change-this-to-a-long-random-string

# Email (Resend — optional). Without a verified domain, mail only reaches your own inbox.
RESEND_API_KEY=re_your_key_here
# Verified sender once you add a domain in Resend (falls back to onboarding@resend.dev).
MAIL_FROM=Daily Devotional <onboarding@resend.dev>

# Vercel only — Vercel Cron sends this as a Bearer token to /api/cron/*.
CRON_SECRET=change-this-to-another-long-random-string
# Vercel only — added automatically when you connect a Blob store (post images).
BLOB_READ_WRITE_TOKEN=

# Public origin of the deployed app (used for CORS + email links).
CLIENT_URL=https://your-app.vercel.app
